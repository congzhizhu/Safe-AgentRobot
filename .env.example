# ===== Safety_Agent 配置（阿里云百炼 API 方案）=====
# 获取地址: https://bailian.console.aliyun.com  ->  API-KEY 管理
# 申请你的 Key（sk- 开头）后粘贴到下面等号后面
QWEN_API_KEY=你的APIKey

# 百炼 OpenAI 兼容接口地址（勿改）
QWEN_API_BASE=https://dashscope.aliyun.com/compatible-mode/v1
# 多模态模型名（qwen-vl-max 效果最好，也可换 qwen-vl-plus 更便宜）
QWEN_MODEL_NAME=qwen-vl-max

# 纯文本模型名（用于自然语言指令解析等文本任务，指令遵循强于多模态模型）
QWEN_TEXT_MODEL_NAME=qwen-plus

# HuggingFace 镜像（勿改）
HF_ENDPOINT=https://hf-mirror.com
